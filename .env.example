# ====================================================================
# XOXO - Master Environment Variables (Netlify + Supabase)
# ====================================================================

# Port & Muhit
PORT=3001
NODE_ENV=production

# --------------------------------------------------------------------
# Telegram Bot & WebApp
# --------------------------------------------------------------------
# Telegram @BotFather dan olingan bot tokeni
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
# Netlify da joylashgan Mini App havolasi
WEBAPP_URL=https://your-xoxo-app.netlify.app

# --------------------------------------------------------------------
# Frontend (Netlify Environment Variables)
# --------------------------------------------------------------------
# Netlify boshqaruv panelida (Site configuration -> Environment variables):
# VITE_BACKEND_URL: Render/Railway/VPS dagi backend manzili
VITE_BACKEND_URL=https://xoxo-backend.onrender.com
VITE_SUPABASE_URL=https://[PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# --------------------------------------------------------------------
# Supabase Database & API
# --------------------------------------------------------------------
# Supabase PostgreSQL URI (Supabase Dashboard -> Settings -> Database):
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Redis (bo'sh qoldirilsa in-memory ishlatiladi)
REDIS_URL=

# --------------------------------------------------------------------
# Havfsizlik va RBAC
# --------------------------------------------------------------------
JWT_SECRET=super-secret-jwt-key-minimum-32-chars-long
SUPER_ADMIN_TELEGRAM_ID=1001
ADMIN_DAILY_GIFT_LIMIT=500

# --------------------------------------------------------------------
# Iqtisodiyot va O'yin Qoidalari
# --------------------------------------------------------------------
INITIAL_TOKENS=25
REFERRAL_BONUS=5
DAILY_BONUS=5
RPS_TIMEOUT_SECONDS=5
TURN_TIMEOUT_SECONDS=20
MAX_RPS_DRAWS=3
