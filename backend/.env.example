# ========================================================
# XOXO Backend - Environment Variables (Supabase & Node.js)
# ========================================================

PORT=3001
NODE_ENV=production

# Telegram Bot
# Telegram @BotFather dan olingan bot tokeni
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
# Netlify ga yuklangan frontend domeni (masalan: https://xoxo-game.netlify.app)
WEBAPP_URL=https://xoxo-game.netlify.app

# Security & RBAC
JWT_SECRET=super-secret-jwt-key-minimum-32-chars-long
SUPER_ADMIN_TELEGRAM_ID=1001
ADMIN_DAILY_GIFT_LIMIT=500

# ========================================================
# Supabase PostgreSQL Database
# ========================================================
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Connection Pooling (port 6543):
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Yoki Direct Connection (port 5432):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase API sozlamalari (Project Settings -> API)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Redis (ixtiyoriy, bo'sh bo'lsa in-memory cache ishlatiladi)
REDIS_URL=

# Game Economy & Rules
INITIAL_TOKENS=25
REFERRAL_BONUS=5
DAILY_BONUS=5
RPS_TIMEOUT_SECONDS=5
TURN_TIMEOUT_SECONDS=20
MAX_RPS_DRAWS=3
