# ========================================================
# XOXO Frontend - Environment Variables (Netlify & Vite)
# ========================================================

# Backend server manzili (Render, Railway, Fly.io yoki VPS dagi backend URL)
# Netlify Environment Variables sozlamalarida kiritiladi.
# Agar bo'sh qoldirilsa, Vite proxy yoki nisbiy /api va /socket.io dan foydalaniladi.
# Misol: https://xoxo-backend.onrender.com
VITE_BACKEND_URL=

# Supabase loyihangiz parametrlari (Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
